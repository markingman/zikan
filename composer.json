{
  "name": "markingman/zikan",
  "description": "A lightweight PHP web application framework",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": ">=8.3",
    "ext-fileinfo": "*"
  },
  "autoload": {
    "psr-4": {
      "Zikan\\": [
        "src"
      ]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Zikan\\Test\\": [
        "tests/fixtures/classes",
        "tests/fixtures/app/src"
      ],
      "Zikan\\": [
        "tests/unit",
        "tests/integration"
      ]
    },
	"files": [
		"tests/fixtures/app/app.php"
	]
  },
  "require-dev": {
     "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "~2.1.22",
    "ext-tidy": "*",
    "ext-xdebug": "*"
  },
  "config": {
    "vendor-dir": "vendor"
  }
}
